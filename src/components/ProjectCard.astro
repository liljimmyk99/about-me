---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { withBase } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level for the project name; pick the level that follows the surrounding heading. */
  level?: 'h2' | 'h3';
}

const { project, level: Heading = 'h3' } = Astro.props;
const { name, oneLiner, kind, stack, screenshots } = project.data;
const [screenshot] = screenshots;
const kindLabel = kind === 'work' ? 'Work' : 'Personal';
---

<article class="card">
  <div class="shot">
    {
      screenshot && (
        <Image src={screenshot.src} alt={screenshot.alt} widths={[400, 800]} sizes="(min-width: 48rem) 380px, 100vw" loading="lazy" />
      )
    }
  </div>
  <div class="body">
    <ul class="strip" aria-label="Project type and stack">
      <li><Tag>{kindLabel}</Tag></li>
      {stack.slice(0, 3).map((item) => <li><Tag>{item}</Tag></li>)}
    </ul>
    <Heading><a href={withBase(`/projects/${project.id}/`)}>{name}</a></Heading>
    <p>{oneLiner}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--gold);
  }
  .shot {
    aspect-ratio: 16 / 9;
    background: var(--surface-deep);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: var(--space-2);
  }
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }
  .body :global(h2),
  .body :global(h3) {
    margin-bottom: var(--space-1);
  }
  .body :global(a) {
    color: var(--text);
    text-decoration: none;
  }
  /* Stretch the title link over the whole card */
  .body :global(a)::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .body :global(a:focus-visible) {
    outline: none;
  }
  .card:has(a:focus-visible) {
    outline: var(--focus-ring) solid var(--gold);
    outline-offset: 3px;
  }
  p {
    margin: 0;
    color: var(--text-body);
  }
</style>
