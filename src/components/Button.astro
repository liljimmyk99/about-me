---
interface Props {
  /** Renders a link when set, otherwise a <button>. */
  href?: string;
  variant?: 'solid' | 'outline';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'solid', type = 'button', class: className } = Astro.props;
const external = href !== undefined && /^https?:\/\//.test(href);
---

{
  href !== undefined ? (
    <a
      class:list={['button', variant, className]}
      href={href}
      rel={external ? 'noopener' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button class:list={['button', variant, className]} type={type}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--gold);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .solid {
    background: var(--gold);
    color: var(--surface-deep);
  }
  .solid:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface-deep);
  }
  .outline {
    background: transparent;
    color: var(--gold);
  }
  .outline:hover {
    background: var(--gold);
    color: var(--surface-deep);
  }
</style>
