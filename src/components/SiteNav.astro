---
import { getSite } from '../lib/content';
const site = await getSite();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;

const links = [
  { label: 'Career stats', href: `${base}/#career` },
  { label: 'Highlights', href: `${base}/projects/` },
  { label: 'Press box', href: `${base}/blog/` },
  { label: 'Bio', href: `${base}/about/` },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={`${base}/`}>{site.name}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current.startsWith(link.href) && !link.href.includes('#') ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<!-- Inline so the phone menu collapses before first paint (no layout shift); without JS the links stay visible -->
<script is:inline>
  (() => {
    const header = document.currentScript.previousElementSibling;
    const toggle = header.querySelector('.menu-toggle');
    const setOpen = (open) => {
      header.dataset.menu = open ? 'open' : 'closed';
      toggle.setAttribute('aria-expanded', String(open));
    };
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(header.dataset.menu === 'closed'));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.menu === 'open') {
        setOpen(false);
        toggle.focus();
      }
    });
    // Same-page links (Career stats) don't reload, so close the menu by hand
    header.querySelector('nav').addEventListener('click', (event) => {
      if (event.target.closest('a')) setOpen(false);
    });
  })();
</script>

<style>
  .site-header {
    background: var(--home);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-4);
    row-gap: var(--space-1);
    padding-block: var(--space-1);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-display);
    font-size: var(--text-card);
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }
  /* Phones: links fold behind a Menu toggle once the inline script has run */
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .menu-toggle::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    margin-top: -0.25rem;
    border-right: 2px solid var(--gold);
    border-bottom: 2px solid var(--gold);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
  }
  .menu-toggle[aria-expanded='true']::after {
    margin-top: 0.25rem;
    transform: rotate(-135deg);
  }
  .site-header[data-menu] .menu-toggle {
    display: inline-flex;
  }
  .site-header[data-menu] nav {
    flex-basis: 100%;
  }
  .site-header[data-menu='closed'] nav {
    display: none;
  }
  .site-header[data-menu] ul {
    flex-direction: column;
    padding-bottom: var(--space-1);
  }
  /* Full-width rows so short links like Bio are easy to tap */
  .site-header[data-menu] nav a {
    display: flex;
  }
  @media (min-width: 48rem) {
    .site-header[data-menu] .menu-toggle {
      display: none;
    }
    .site-header[data-menu] nav {
      display: block;
      flex-basis: auto;
    }
    .site-header[data-menu] ul {
      flex-direction: row;
      padding-bottom: 0;
    }
    .site-header[data-menu] nav a {
      display: inline-flex;
    }
  }
</style>
