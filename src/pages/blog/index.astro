---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostRow from '../../components/PostRow.astro';
import Tag from '../../components/Tag.astro';
import { getPosts, getTags } from '../../lib/content';
import { withBase } from '../../lib/url';

const [posts, tags] = await Promise.all([getPosts(), getTags()]);
---

<BaseLayout title="Blog" description="Posts on mobile engineering, projects and life off the field.">
  <div class="container page">
    <SectionHeader eyebrow="Press box" title="Blog" level="h1" />
    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Filter by tag">
          {tags.map(({ tag, slug, count }) => <li><Tag href={withBase(`/blog/tags/${slug}/`)}>{tag} ({count})</Tag></li>)}
        </ul>
      )
    }
    {posts.length > 0 ? posts.map((post) => <PostRow post={post} />) : <p>No posts yet.</p>}
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>
