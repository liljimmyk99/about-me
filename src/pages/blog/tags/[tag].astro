---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import PostRow from '../../../components/PostRow.astro';
import Tag from '../../../components/Tag.astro';
import { getPosts, getTags, slugifyTag } from '../../../lib/content';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const [tags, posts] = await Promise.all([getTags(), getPosts()]);
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      tags,
      posts: posts.filter((post) => post.data.tags.some((t) => slugifyTag(t) === slug)),
    },
  }));
}

const { tag, tags, posts } = Astro.props;
---

<BaseLayout title={`Posts tagged ${tag}`} description={`All posts tagged ${tag}.`}>
  <div class="container page">
    <SectionHeader eyebrow="Tag" title={tag} level="h1" />
    <p class="back"><a href={withBase('/blog/')}>&larr; All posts</a></p>
    <ul class="tags" aria-label="Filter by tag">
      {tags.map((t) => <li><Tag href={withBase(`/blog/tags/${t.slug}/`)} active={t.tag === tag}>{t.tag} ({t.count})</Tag></li>)}
    </ul>
    {posts.map((post) => <PostRow post={post} />)}
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .back {
    margin: 0 0 var(--space-3);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>
