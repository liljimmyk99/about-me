---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Tag from '../../components/Tag.astro';
import BoxScore from '../../components/BoxScore.astro';
import PostCard from '../../components/PostCard.astro';
import PostRow from '../../components/PostRow.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getPosts, getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  const posts = await getPosts();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      previous: projects[i - 1],
      next: projects[i + 1],
      related: posts.filter((post) => post.data.relatedProject?.id === project.id),
    },
  }));
}

const { project, previous, next, related } = Astro.props;
const { name, oneLiner, kind, layer, platform, role, started, status, stack, repo, live, appStore, screenshots } =
  project.data;
const { Content } = await render(project);

const startedLabel = started.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const kindLabel = kind === 'work' ? 'Work' : 'Personal';
---

<BaseLayout title={name} description={oneLiner}>
  <article class="container page">
    <header>
      <ul class="tags" aria-label="Project type">
        <li><Tag>{kindLabel}</Tag></li>
        <li><Tag>{layer}</Tag></li>
      </ul>
      <h1>{name}</h1>
      <p class="one-liner">{oneLiner}</p>
      {
        (repo || live || appStore) && (
          <p class="actions">
            {repo && <Button href={repo}>Source</Button>}
            {live && <Button href={live} variant="outline">Live site</Button>}
            {appStore && <Button href={appStore} variant="outline">App Store</Button>}
          </p>
        )
      }
    </header>

    <div class="layout">
      <div class="main">
        {
          screenshots.length > 0 && (
            <div class="carousel" data-carousel>
              <div class="shots" role="group" aria-roledescription="carousel" aria-label={`${name} screenshots`} tabindex="0" data-track>
                {screenshots.map((shot, i) => (
                  <figure role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${screenshots.length}`}>
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={[640, 1280]}
                      sizes="(min-width: 64rem) 720px, 100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  </figure>
                ))}
              </div>
              {screenshots.length > 1 && (
                <div class="controls">
                  <button type="button" data-prev aria-label="Previous screenshot">←</button>
                  <span data-status aria-live="polite">1 / {screenshots.length}</span>
                  <button type="button" data-next aria-label="Next screenshot">→</button>
                </div>
              )}
            </div>
          )
        }
        <div class="prose"><Content /></div>

        <section aria-labelledby="stack-title" class="stack">
          <h2 id="stack-title">Stack</h2>
          <ul class="tags">
            {stack.map((item) => <li><Tag>{item}</Tag></li>)}
          </ul>
        </section>

        {
          related.length > 0 && (
            <section aria-labelledby="related-title" class="related">
              <SectionHeader eyebrow="Press box" title="Related posts" id="related-title" />
              {related.map((post) => <PostRow post={post} />)}
            </section>
          )
        }
      </div>

      <div class="side">
        <BoxScore
          title="Spec sheet"
          items={[
            { label: 'Type', value: `${kindLabel}, ${layer}` },
            { label: 'Role', value: role },
            { label: 'Platform', value: platform },
            { label: 'Started', value: startedLabel },
            { label: 'Status', value: status },
          ]}
        />
      </div>
    </div>

    <nav class="pager" aria-label="More projects">
      {previous ? <PostCard direction="prev" title={previous.data.name} href={`/projects/${previous.id}/`} /> : <span />}
      {next ? <PostCard direction="next" title={next.data.name} href={`/projects/${next.id}/`} /> : <span />}
    </nav>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!track) return;
    const slides = [...track.children] as HTMLElement[];
    // Measure each slide's real position: stepping by the track width ignores the gap between
    // slides, so the browser snapped to the wrong slide (or back to the same one)
    const offsetOf = (slide: HTMLElement) => slide.offsetLeft - slides[0].offsetLeft;
    const nearest = () =>
      slides.reduce(
        (best, slide, i) =>
          Math.abs(offsetOf(slide) - track.scrollLeft) < Math.abs(offsetOf(slides[best]) - track.scrollLeft) ? i : best,
        0,
      );
    // The slide we're on or heading to; buttons step from here so quick taps don't stall mid-scroll
    let index = 0;
    const go = (dir: number) => {
      index = Math.min(Math.max(index + dir, 0), slides.length - 1);
      track.scrollTo({ left: offsetOf(slides[index]) });
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      if (status) status.textContent = `${nearest() + 1} / ${slides.length}`;
    });
    // Swipes move the track directly, so pick up the slide they land on once scrolling stops
    const sync = () => (index = nearest());
    if ('onscrollend' in window) {
      track.addEventListener('scrollend', sync);
    } else {
      let settle: ReturnType<typeof setTimeout>;
      track.addEventListener('scroll', () => {
        clearTimeout(settle);
        settle = setTimeout(sync, 400);
      });
    }
  });
</script>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }
  h1 {
    font-size: var(--text-hero);
    overflow-wrap: anywhere;
  }
  .one-liner {
    max-width: var(--measure);
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-long);
    line-height: var(--leading-long);
    color: var(--text-body);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .layout {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .main {
    min-width: 0;
  }
  .carousel {
    margin-bottom: var(--space-4);
  }
  .shots {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .shots::-webkit-scrollbar {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .shots {
      scroll-behavior: smooth;
    }
  }
  figure {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: center;
    /* A fast flick moves one slide, not several */
    scroll-snap-stop: always;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-variant-numeric: tabular-nums;
  }
  .controls button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: var(--surface-deep);
    border: 1px solid var(--line);
  }
  .prose {
    max-width: var(--measure);
    font-size: var(--text-long);
    line-height: var(--leading-long);
    color: var(--text-body);
  }
  .stack,
  .related {
    margin-top: var(--space-6);
  }
  .stack h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-card);
  }
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
    .side {
      position: sticky;
      top: var(--space-3);
      align-self: start;
    }
  }
</style>
