---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BoxScore from '../components/BoxScore.astro';
import PullQuote from '../components/PullQuote.astro';
import Button from '../components/Button.astro';
import { photos } from '../data/photos';
import { getBioChapters, getProfile, getSite, getTrophies } from '../lib/content';
import { withBase } from '../lib/url';

const [site, profile, chapters, trophies] = await Promise.all([
  getSite(),
  getProfile(),
  getBioChapters(),
  getTrophies(),
]);
const rendered = await Promise.all(
  chapters.map(async (chapter) => ({ chapter, Content: (await render(chapter)).Content })),
);
---

<BaseLayout title="Bio" description={`Player profile for ${site.name}: story, vitals, intangibles and trophy case.`}>
  <section class="container profile">
    <Image
      class="portrait"
      src={photos.headShot.src}
      alt={photos.headShot.alt}
      widths={[320, 640]}
      sizes="(min-width: 48rem) 320px, 100vw"
      loading="eager"
    />
    <div class="intro">
      <p class="eyebrow">Player bio</p>
      <h1>{site.name}</h1>
      <p class="summary">{profile.scoutingSummary}</p>
      <dl class="vitals">
        {
          profile.vitals.map((vital) => (
            <div>
              <dt>{vital.label}</dt>
              <dd>{vital.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <nav class="container chapter-bar" aria-label="Chapters">
    <ul>
      {
        rendered.map(({ chapter }) => (
          <li><a href={`#${chapter.id}`}>{chapter.data.title}</a></li>
        ))
      }
    </ul>
  </nav>

  <div class="container layout">
    <div class="story">
      {
        rendered.map(({ chapter, Content }) => (
          <section id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
            <SectionHeader eyebrow={`Quarter ${chapter.data.order}`} title={chapter.data.title} id={`${chapter.id}-title`} />
            <div class="prose"><Content /></div>
            {chapter.data.photo && (
              <figure>
                <Image src={chapter.data.photo.src} alt={chapter.data.photo.alt} widths={[640, 1280]} sizes="(min-width: 64rem) 720px, 100vw" loading="lazy" />
                <figcaption>{chapter.data.photo.caption}</figcaption>
              </figure>
            )}
            {chapter.data.pullQuote && <PullQuote>{chapter.data.pullQuote}</PullQuote>}
          </section>
        ))
      }
    </div>

    <aside class="sidebar" aria-label="Intangibles and trophy case">
      <BoxScore title="Intangibles" items={[]}>
        <ul class="intangibles">
          {
            profile.intangibles.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </BoxScore>
      <BoxScore
        title="Trophy case"
        side="away"
        items={trophies.map(({ data }) => ({ label: String(data.year), value: data.org ? `${data.title} (${data.org})` : data.title }))}
      />
    </aside>
  </div>

  <section class="container signing" aria-labelledby="signing-title">
    <SectionHeader eyebrow="Call to action" title={profile.nowSigning.heading} id="signing-title" />
    <p>{profile.nowSigning.text}</p>
    <p class="actions">
      <Button href={site.socials.linkedin.href}>LinkedIn</Button>
      <Button href={withBase(site.resume)} variant="outline">Résumé PDF</Button>
    </p>
  </section>
</BaseLayout>

<style>
  .profile {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }
  .portrait {
    width: 100%;
    max-width: 20rem;
    height: auto;
    border: 1px solid var(--line);
  }
  .eyebrow {
    margin: 0 0 var(--space-1);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold);
  }
  h1 {
    font-size: var(--text-hero);
    overflow-wrap: anywhere;
  }
  .summary {
    max-width: var(--measure);
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-long);
    line-height: var(--leading-long);
    color: var(--text-body);
  }
  .vitals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .vitals div {
    padding: var(--space-1) var(--space-2);
    background: var(--surface-deep);
  }
  dt {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .chapter-bar {
    margin-top: var(--space-6);
  }
  .chapter-bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1) 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .chapter-bar a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .chapter-bar a:hover {
    color: var(--surface-deep);
    background: var(--gold);
    border-color: var(--gold);
  }
  .layout {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }
  .story > section {
    margin-bottom: var(--space-8);
    scroll-margin-top: var(--space-4);
  }
  .prose {
    max-width: var(--measure);
    font-size: var(--text-long);
    line-height: var(--leading-long);
    color: var(--text-body);
  }
  figure {
    max-width: var(--measure);
    margin: var(--space-4) 0 0;
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: var(--space-1);
    font-size: var(--text-label-lg);
    color: var(--text-muted);
  }
  .sidebar {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }
  .intangibles {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .intangibles li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--line-soft);
  }
  .intangibles li:last-child {
    border-bottom: 0;
  }
  .intangibles strong {
    font-family: var(--font-label);
    font-size: var(--text-label-lg);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold);
  }
  .intangibles span {
    color: var(--text-body);
  }
  .signing {
    margin-top: var(--space-4);
    padding: var(--space-6) var(--gutter);
    background: var(--home);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (min-width: 48rem) {
    .profile {
      grid-template-columns: 20rem 1fr;
      align-items: start;
    }
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
    .sidebar {
      position: sticky;
      top: var(--space-3);
    }
  }
</style>
